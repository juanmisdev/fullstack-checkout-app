# dependencies
node_modules/

# builds
dist/
build/
coverage/

# env — never commit secrets or API keys
.env
.env.*
!.env.example
# .env.development is committed: it only carries the public deployed API URL
# (no secrets); local overrides go in .env.development.local (still ignored).
!client/.env.development

# misc
.DS_Store
*.log
# local tooling (SDD/odd artifacts) — not part of the app
.atl/
odd/
openspec/

# serverless build artifacts
.serverless/
*.tsbuildinfo

# playwright local artifacts
test-results/
playwright-report/
